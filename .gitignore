# Test keys (private key only — never commit)
test/keys/test_id_ed25519

# Built artifacts
bin/bootstrap
test/images/*.qcow2
test/images/output/

# Rendered cloud-init seed (generated by build-base-image from user-data.tmpl)
test/images/http/user-data
test/images/seed.iso

# Vault init output — store securely, never commit
vault-init.json

# Runtime config with secrets — never commit
.env

# Operator-specific controller topology and local key paths
config.yaml
test/config-ssd.yaml

# Test config backups
config.yaml.bak

# Go
*.exe
*.test
vendor/

# Terraform provider and module working directories. Lockfiles remain tracked
# candidates because these modules are also applied as standalone roots.
**/.terraform/

# Logs
logs/

# Packer cache
packer_cache/

# Molecule
.molecule/
.hermit/
.venv/
ansible/collections/

# Git worktrees
.worktrees/
