#cloud-config
# Rendered from user-data.tmpl by 'just build-base-image'.
# SSH_PUBLIC_KEY is injected from test/keys/test_id_ed25519.pub at build time.

users:
  - name: ansible
    sudo: ALL=(ALL) NOPASSWD:ALL
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - ${SSH_PUBLIC_KEY}

ssh_pwauth: false
