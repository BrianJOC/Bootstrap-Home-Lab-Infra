#cloud-config
autoinstall:
  version: 1
  identity:
    hostname: bootstrap-test
    username: ansible
    password: "$6$rounds=4096$test$..."  # locked, key-only auth
  ssh:
    install-server: true
    authorized-keys:
      - "ssh-ed25519 PLACEHOLDER replace-after-generate-test-keys"
    allow-pw: false
  packages:
    - python3
    - python3-apt
  user-data:
    users:
      - name: ansible
        sudo: ALL=(ALL) NOPASSWD:ALL
        shell: /bin/bash
  late-commands:
    - "echo 'ansible ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/ansible"
    - "chmod 440 /target/etc/sudoers.d/ansible"
