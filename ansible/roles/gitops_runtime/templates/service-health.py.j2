#!/usr/bin/env python3
"""Check TLS and the authentication boundary without privileged app credentials."""
import datetime
import json
import os
import subprocess
import urllib.error
import urllib.request
import urllib.parse

class NoRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        return None

opener = urllib.request.build_opener(NoRedirect)
with open('/etc/bootstrap-home-infra/gitops-services.json') as stream:
    services = json.load(stream)
results = {}
for service in services:
    location = ''
    try:
        with opener.open('https://' + service['hostname'] + '/', timeout=10) as response:
            status = response.status
            location = response.headers.get('Location', '')
    except urllib.error.HTTPError as error:
        status = error.code
        location = error.headers.get('Location', '')
    except (urllib.error.URLError, TimeoutError):
        status = 0
    redirect = urllib.parse.urlparse(location)
    boundary = (status == 302 and redirect.scheme == 'https'
                and redirect.netloc == 'authentik.{{ internal_domain }}'
                and redirect.path.startswith('/application/o/'))
    target = service['target']
    health = service['health_check']
    health_path = '/' if health == 'http' else health.removeprefix('http:')
    proxy_path = (f"/api/v1/namespaces/{target['namespace']}/services/"
                  f"http:{target['service']}:{target['port']}/proxy{health_path}")
    try:
        probe = subprocess.run(
            ['/usr/local/bin/k3s', 'kubectl', '--kubeconfig',
             '/etc/bootstrap-home-infra/gitops-kubeconfig-' + target['cluster'],
             '--request-timeout=10s', 'get', '--raw', proxy_path],
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=15, check=False)
        application = probe.returncode == 0
    except (OSError, subprocess.TimeoutExpired):
        application = False
    results[service['name']] = {'https_auth_boundary': boundary,
                                'application': application, 'status': status}
path = '/var/lib/bootstrap-home-infra/gitops-services/status.json'
with open(path + '.tmp', 'w') as stream:
    json.dump({'checked_at': datetime.datetime.now(datetime.timezone.utc).isoformat(), 'services': results}, stream)
os.replace(path + '.tmp', path)
if not all(result['https_auth_boundary'] and result['application'] for result in results.values()):
    raise SystemExit(1)
