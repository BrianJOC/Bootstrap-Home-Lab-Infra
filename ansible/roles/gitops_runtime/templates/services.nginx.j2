# Reviewed GitLab service definitions. TLS uses the host's atomically renewed
# wildcard certificate, so service deployment introduces no second ACME owner.
{% for service in gitops_services %}
server {
  listen 443 ssl;
  server_name {{ service.hostname }};
  ssl_certificate {{ cert_dir }}/certificates/_.{{ internal_domain }}.crt;
  ssl_certificate_key {{ cert_dir }}/certificates/_.{{ internal_domain }}.key;
  location / {
    proxy_pass http://{{ gitops_clusters[service.target.cluster].address }}:{{ service.target.node_port }};
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $bootstrap_connection_upgrade;
  }
}
{% endfor %}
