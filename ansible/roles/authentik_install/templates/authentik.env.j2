# Authentik environment file — managed by Ansible
# Mode 0600 — do not commit; contains secrets

AUTHENTIK_SECRET_KEY={{ authentik_secret_key }}

{% if not authentik_db_initialized | default(false) %}
# Bootstrap credentials — applied on first run only. Removed from .env once
# Authentik marks itself initialized ({{ authentik_data_dir }}/.initialized).
AUTHENTIK_BOOTSTRAP_PASSWORD={{ authentik_admin_password }}
AUTHENTIK_BOOTSTRAP_EMAIL={{ admin_email }}
{% if authentik_bootstrap_token != "" %}
AUTHENTIK_BOOTSTRAP_TOKEN={{ authentik_bootstrap_token }}
{% endif %}
{% endif %}

{% if authentik_use_bundled_postgres %}
PG_PASS={{ authentik_pg_password }}
{% else %}
AUTHENTIK_PG_HOST={{ bootstrap_server_ip }}
AUTHENTIK_PG_USER=authentik
AUTHENTIK_PG_NAME=authentik
AUTHENTIK_PG_PASS={{ authentik_pg_password }}
{% endif %}
