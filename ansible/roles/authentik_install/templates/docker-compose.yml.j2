---
services:
  authentik-server:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    container_name: authentik-server
    restart: unless-stopped
    command: server
    environment:
      AUTHENTIK_REDIS__HOST: authentik-redis
      AUTHENTIK_SECRET_KEY: ${AUTHENTIK_SECRET_KEY}
      AUTHENTIK_POSTGRESQL__HOST: ${AUTHENTIK_PG_HOST}
      AUTHENTIK_POSTGRESQL__USER: ${AUTHENTIK_PG_USER}
      AUTHENTIK_POSTGRESQL__NAME: ${AUTHENTIK_PG_NAME}
      AUTHENTIK_POSTGRESQL__PASSWORD: ${AUTHENTIK_PG_PASS}
    volumes:
      - "{{ (service_data_root + '/authentik') if service_data_root else '/opt/authentik' }}/media:/media"
      - "{{ (service_data_root + '/authentik') if service_data_root else '/opt/authentik' }}/custom-templates:/templates"
    ports:
      - "{{ authentik_port_http }}:9000"
      - "{{ authentik_port_https }}:9443"
    depends_on:
      - authentik-redis

  authentik-worker:
    image: ghcr.io/goauthentik/server:{{ authentik_version }}
    container_name: authentik-worker
    restart: unless-stopped
    command: worker
    environment:
      AUTHENTIK_REDIS__HOST: authentik-redis
      AUTHENTIK_SECRET_KEY: ${AUTHENTIK_SECRET_KEY}
      AUTHENTIK_POSTGRESQL__HOST: ${AUTHENTIK_PG_HOST}
      AUTHENTIK_POSTGRESQL__USER: ${AUTHENTIK_PG_USER}
      AUTHENTIK_POSTGRESQL__NAME: ${AUTHENTIK_PG_NAME}
      AUTHENTIK_POSTGRESQL__PASSWORD: ${AUTHENTIK_PG_PASS}
    volumes:
      # Docker socket required for Authentik embedded outpost management. This grants
      # the worker container root-equivalent host access. Acceptable for homelab; for
      # stricter environments replace with a docker-socket-proxy that whitelists only
      # the container lifecycle API calls Authentik requires.
      - /var/run/docker.sock:/var/run/docker.sock
      - "{{ (service_data_root + '/authentik') if service_data_root else '/opt/authentik' }}/media:/media"
      - "{{ (service_data_root + '/authentik') if service_data_root else '/opt/authentik' }}/custom-templates:/templates"
    depends_on:
      - authentik-redis

  authentik-redis:
    image: redis:7-alpine
    container_name: authentik-redis
    restart: unless-stopped
    command: --save 60 1 --loglevel warning
