# Managed by bootstrap-home-infra. TLS terminates once on the constrained host;
# services keep distinct DNS names and private loopback listeners.

map $http_upgrade $bootstrap_connection_upgrade {
  default upgrade;
  '' close;
}

server {
  listen 80 default_server;
  listen [::]:80 default_server;
  server_name _;
  return 301 https://$host$request_uri;
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name authentik.{{ internal_domain }};
  ssl_certificate {{ cert_dir }}/certificates/_.{{ internal_domain }}.crt;
  ssl_certificate_key {{ cert_dir }}/certificates/_.{{ internal_domain }}.key;
  location / {
    proxy_pass http://127.0.0.1:9000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $bootstrap_connection_upgrade;
  }
}

server {
  listen 443 ssl default_server;
  listen [::]:443 ssl default_server;
  server_name gitlab.{{ internal_domain }};
  ssl_certificate {{ cert_dir }}/certificates/_.{{ internal_domain }}.crt;
  ssl_certificate_key {{ cert_dir }}/certificates/_.{{ internal_domain }}.key;
  client_max_body_size 0;
  location / {
    proxy_pass http://127.0.0.1:8181;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-Ssl on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $bootstrap_connection_upgrade;
  }
}

server {
  listen 443 ssl;
  listen [::]:443 ssl;
  server_name vault.{{ internal_domain }};
  ssl_certificate {{ cert_dir }}/certificates/_.{{ internal_domain }}.crt;
  ssl_certificate_key {{ cert_dir }}/certificates/_.{{ internal_domain }}.key;
  location / {
    proxy_pass https://127.0.0.1:8200;
    proxy_ssl_verify off;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  }
}

