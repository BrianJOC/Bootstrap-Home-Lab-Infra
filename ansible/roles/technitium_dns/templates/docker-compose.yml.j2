---
services:
  technitium:
    image: technitium/dns-server:latest
    container_name: technitium
    restart: unless-stopped
    ports:
      - "{{ technitium_port_dns }}:53/udp"
      - "{{ technitium_port_dns }}:53/tcp"
      - "{{ technitium_port_http }}:5380"
    volumes:
      - "{{ (service_data_root + '/technitium') if service_data_root else '/opt/technitium/data' }}:/etc/dns"
    environment:
      - DNS_SERVER_DOMAIN={{ internal_domain }}
      - DNS_SERVER_ADMIN_PASSWORD={{ technitium_admin_password }}
