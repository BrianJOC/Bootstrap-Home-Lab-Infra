# Managed by Ansible — gitlab_install role
# Secrets are passed as environment variables — never stored in this file

external_url 'https://gitlab.{{ internal_domain }}'

gitaly['configuration'] = {
  storage: [
    {
      name: 'default',
      path: '{{ (service_data_root + '/gitlab/repositories') if service_data_root else '/var/opt/gitlab/git-data/repositories' }}'
    }
  ]
}

# Disable bundled PostgreSQL — use shared instance
postgresql['enable'] = false
gitlab_rails['db_adapter'] = 'postgresql'
gitlab_rails['db_host'] = '{{ bootstrap_server_ip }}'
gitlab_rails['db_port'] = 5432
gitlab_rails['db_database'] = 'gitlab'
gitlab_rails['db_username'] = 'gitlab'
gitlab_rails['db_password'] = File.read('/etc/bootstrap-home-infra/gitlab-db-password').strip

# Shared host Nginx terminates wildcard TLS and forwards only over loopback.
# GitLab still advertises its public HTTPS URL for callbacks and generated links.
gitlab_rails['nginx']['listen_port'] = 8181
gitlab_rails['nginx']['listen_https'] = false
gitlab_rails['nginx']['redirect_http_to_https'] = false

# Puma's default port 8080 collides with the Cloudflare mock when the test mocks run on
# the target (that container publishes 0.0.0.0:8080), which leaves workhorse's upstream
# stale and every request 502s. The host nginx vhost proxies 8181, so keep Puma on 8081.
puma['port'] = 8081
# GitLab always trusts both localhost families. Keep only the explicit IPv4
# proxy here because Omnibus 19.3 renders an explicit IPv6 entry as a YAML
# symbol, which Rails cannot pass to IPAddr.
gitlab_rails['trusted_proxies'] = ['127.0.0.1/32']

# Authentik OIDC SSO
gitlab_rails['omniauth_enabled'] = true
gitlab_rails['omniauth_allow_single_sign_on'] = ['openid_connect']
gitlab_rails['omniauth_sync_email_from_provider'] = 'openid_connect'
gitlab_rails['omniauth_sync_profile_from_provider'] = ['openid_connect']
gitlab_rails['omniauth_auto_sign_in_with_provider'] = nil
gitlab_rails['omniauth_block_auto_created_users'] = false
gitlab_rails['omniauth_providers'] = [
  {
    name: 'openid_connect',
    label: 'Authentik',
    args: {
      name: 'openid_connect',
      scope: ['openid', 'profile', 'email'],
      response_type: 'code',
      issuer: 'https://authentik.{{ internal_domain }}/application/o/gitlab/',
      discovery: true,
      client_auth_method: 'client_secret_post',
      uid_field: 'sub',
      send_scope_to_token_endpoint: 'false',
      pkce: true,
      client_options: {
        identifier: '{{ gitlab_oidc_client_id | default("gitlab") }}',
        secret: File.read('/etc/bootstrap-home-infra/gitlab-oidc-secret').strip,
        redirect_uri: 'https://gitlab.{{ internal_domain }}/users/auth/openid_connect/callback'
      }
    }
  }
]

# Disable bundled Redis if needed (using bundled Redis for now)
# redis['enable'] = false

# GitLab Shell
gitlab_shell['auth_file'] = '/home/git/.ssh/authorized_keys'

# Logging
logging['logrotate_frequency'] = 'weekly'
logging['logrotate_rotate'] = 52
