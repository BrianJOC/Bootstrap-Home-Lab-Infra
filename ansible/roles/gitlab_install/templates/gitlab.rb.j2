# Managed by Ansible — gitlab_install role
# Secrets are passed as environment variables — never stored in this file

external_url 'https://gitlab.{{ internal_domain }}'

# NOTE: git_data_dirs was REMOVED in omnibus 18.0 — setting it aborts reconfigure
# ("Removed configurations found in gitlab.rb"). GitLab uses its default git-data path
# unless a gitaly['configuration'] storage block overrides it (dual-disk plan).

# Disable bundled PostgreSQL — use shared instance
postgresql['enable'] = false
gitlab_rails['db_adapter'] = 'postgresql'
gitlab_rails['db_host'] = '{{ bootstrap_server_ip }}'
gitlab_rails['db_port'] = 5432
gitlab_rails['db_database'] = 'gitlab'
gitlab_rails['db_username'] = 'gitlab'
gitlab_rails['db_password'] = ENV['GITLAB_DB_PASSWORD']

# TLS configuration — wildcard cert from Stage 2 (lego stores as _.domain.crt)
# gitlab_rails['nginx'][...] is the omnibus 18 name; the old nginx[...] keys are deprecated.
gitlab_rails['nginx']['ssl_certificate'] = "{{ gitlab_cert_dir }}/certificates/_.{{ internal_domain }}.crt"
gitlab_rails['nginx']['ssl_certificate_key'] = "{{ gitlab_cert_dir }}/certificates/_.{{ internal_domain }}.key"

# Never attempt public Let's Encrypt — the domain is internal-only and the certs come
# from Stage 2. Without this, omnibus enables letsencrypt for an https external_url and
# every reconfigure fails on NXDOMAIN validation.
letsencrypt['enable'] = false

# Puma listens on 127.0.0.1:8080 by default, which collides with the cloudflare-mock
# container when the test mocks run on the target (it publishes 0.0.0.0:8080) — puma then
# boot-loops on Errno::EADDRINUSE and the health check can never pass. Moving the internal
# port keeps GitLab independent of mock state; nginx/workhorse follow this attribute.
puma['port'] = 8081

# Authentik OIDC SSO
gitlab_rails['omniauth_enabled'] = true
gitlab_rails['omniauth_allow_single_sign_on'] = ['openid_connect']
gitlab_rails['omniauth_sync_email_from_provider'] = 'openid_connect'
gitlab_rails['omniauth_sync_profile_from_provider'] = ['openid_connect']
gitlab_rails['omniauth_auto_sign_in_with_provider'] = nil
gitlab_rails['omniauth_block_auto_created_users'] = false
gitlab_rails['omniauth_providers'] = [
  {
    name: 'openid_connect',
    label: 'Authentik',
    args: {
      name: 'openid_connect',
      scope: ['openid', 'profile', 'email'],
      response_type: 'code',
      issuer: 'https://authentik.{{ internal_domain }}/application/o/gitlab/',
      discovery: true,
      client_auth_method: 'client_secret_post',
      uid_field: 'sub',
      send_scope_to_token_endpoint: 'false',
      pkce: true,
      client_options: {
        identifier: '{{ gitlab_oidc_client_id | default("gitlab") }}',
        secret: ENV['GITLAB_OIDC_SECRET'],
        redirect_uri: 'https://gitlab.{{ internal_domain }}/users/auth/openid_connect/callback'
      }
    }
  }
]

# Disable bundled Redis if needed (using bundled Redis for now)
# redis['enable'] = false

# GitLab Shell
gitlab_shell['auth_file'] = '/home/git/.ssh/authorized_keys'

# Logging
logging['logrotate_frequency'] = 'weekly'
logging['logrotate_rotate'] = 52
